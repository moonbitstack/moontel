// The library in one import: `trace`, `propagate`, `asgi`, `log` and `meter`
// re-exported, so a program that wants all five spells the module name once. A
// caller that wants only the span model imports `moonbitstack/moontel/trace` and
// pulls in neither the ASGI types nor the async runtime behind them.
//
// Two packages are deliberately left out. `semconv` is a few hundred names, which
// would bury the twenty below; `otlp` writes request bodies and needs a transport,
// and a program that only traces should carry neither.
import {
  "moonbitstack/moontel/trace",
  "moonbitstack/moontel/propagate",
  "moonbitstack/moontel/asgi",
  "moonbitstack/moontel/log",
  "moonbitstack/moontel/meter",
}

// The cross-check at the root replays a recorded run of another implementation, so
// it reads hexadecimal ids and parses the record with the core JSON reader.
import {
  "moonbitstack/moonbase/base16",
  "moonbitlang/core/json",
} for "wbtest"
