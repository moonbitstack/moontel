///|
/// One generated file: the schema it is read from, and where it lands.
///
/// The name the parser is given is flat — `trace.proto` rather than
/// `opentelemetry/proto/trace/v1/trace.proto` — because the generator places a
/// file's types in the package the file's directory names, and every message here
/// belongs to one package.
struct Source {
  schema : String
  key : String
  output : String
}

///|
/// The schemas the three signals are sent in, and the reply that answers them.
///
/// One list rather than three: a span refers to a `Resource` and an `AnyValue`
/// declared in another file, and the generator resolves those names across the
/// whole set.
///
/// Pinned to `open-telemetry/opentelemetry-proto` at
/// 169f2f2c7c1550c364d5eecb05d1b6163a011b06.
let sources : Array[Source] = [
  {
    schema: "common/v1/common.proto",
    key: "common.proto",
    output: "common.g.mbt",
  },
  {
    schema: "resource/v1/resource.proto",
    key: "resource.proto",
    output: "resource.g.mbt",
  },
  { schema: "trace/v1/trace.proto", key: "trace.proto", output: "trace.g.mbt", },
  { schema: "logs/v1/logs.proto", key: "logs.proto", output: "logs.g.mbt", },
  {
    schema: "metrics/v1/metrics.proto",
    key: "metrics.proto",
    output: "metrics.g.mbt",
  },
  {
    schema: "collector/trace/v1/trace_service.proto",
    key: "trace_service.proto",
    output: "trace_service.g.mbt",
  },
  {
    schema: "collector/logs/v1/logs_service.proto",
    key: "logs_service.proto",
    output: "logs_service.g.mbt",
  },
  {
    schema: "collector/metrics/v1/metrics_service.proto",
    key: "metrics_service.proto",
    output: "metrics_service.g.mbt",
  },
]

///|
let schema_root : String = "scripts/otlp-schema/opentelemetry/proto"

///|
let output_root : String = "src/otlp/binary"

///|
/// What every generated file says above its declarations: which schema it came
/// from, and the commit that schema was read at, so a reader can tell a stale file
/// from a wrong one.
fn header(source : Source) -> String {
  "// Copyright 2026 Leo Cheng\n" +
  "// SPDX-License-Identifier: Apache-2.0\n" +
  "//\n" +
  "// Generated by `src/cmd/gen-otlp-proto` from `" +
  schema_root +
  "/" +
  source.schema +
  "` at\n" +
  "// open-telemetry/opentelemetry-proto 169f2f2c7c1550c364d5eecb05d1b6163a011b06. Do not edit:\n" +
  "// move the pin and run the generator.\n\n"
}

///|
/// The generator's own opening line replaced by the header above. It names a tool
/// a reader of this repository does not run, and says nothing about where the
/// schema came from.
fn strip_generated_banner(text : String) -> String {
  match text.find("\n\n") {
    Some(at) => text[at + 2:].to_owned()
    None => text
  }
}

///|
/// Generate every file, or — with `--check` — compare what would be written with
/// what is committed, and fail if they differ.
async fn main {
  let check = @env.args().contains("--check")
  let parsed : Array[@desc.FileDescriptorProto] = []
  for source in sources {
    let path = schema_root + "/" + source.schema
    let text = @fs.read_file(path) catch {
      error => fail("cannot read " + path + ": " + error.to_string())
    }
    parsed.push(
      @parser.parse(source.key, text.text()) catch {
        error => fail("cannot parse " + path + ": " + error.to_string())
      },
    )
  }
  let symbols = @gen.Symbols::new()
  for file in parsed {
    symbols.add_file(file)
  }
  let mut stale = 0
  for index, source in sources {
    let body = @gen.generate_source_with(parsed[index], symbols) catch {
      error =>
        fail("cannot generate " + source.schema + ": " + error.to_string())
    }
    let text = header(source) + strip_generated_banner(body)
    let path = output_root + "/" + source.output
    if check {
      let committed : String? = Some(@fs.read_file(path).text()) catch {
        _ => None
      }
      match committed {
        Some(committed) =>
          if committed != text {
            println(path + " is not what the schema says")
            stale = stale + 1
          }
        None => {
          println(path + " is missing")
          stale = stale + 1
        }
      }
    } else {
      @fs.write_file(path, text)
    }
  }
  if stale > 0 {
    fail(stale.to_string() + " generated files are out of date")
  }
}
