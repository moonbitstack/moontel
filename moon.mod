name = "moonbitstack/moontel"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontel"

license = "Apache-2.0"

keywords = [
  "opentelemetry",
  "otel",
  "otlp",
  "otlp-json",
  "otlp-http",
  "otlp-protobuf",
  "otlp-grpc",
  "protobuf",
  "grpc",
  "tracing",
  "distributed-tracing",
  "trace-context",
  "w3c-trace-context",
  "traceparent",
  "tracestate",
  "baggage",
  "span",
  "sampler",
  "propagation",
  "metrics",
  "histogram",
  "summary",
  "logs",
  "logging",
  "log-record",
  "semconv",
  "semantic-conventions",
  "genai",
  "exporter",
  "batching",
  "retry",
  "backoff",
  "prometheus",
  "observability",
  "telemetry",
  "instrumentation",
  "asgi",
  "moonbit",
]

description = "OpenTelemetry for MoonBit."

source = "src"

import {
  "moonbitstack/moonast@0.2.7",
  "moonbitlang/parser@0.4.6",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonasgi@0.10.8",
  "moonbitstack/moonbase@0.4.4",
  "moonbitstack/moonseed@0.1.3",
  "moonbitstack/moonfetch@0.1.8",
  "moonbitstack/moonlog@0.1.7",
  "moonbitstack/moonzip@0.3.8",
  "moonbitstack/moonp8s@0.1.2",
  "moonbitstack/moonrpc@0.21.14",
  "moonbitstack/moonhttp@0.15.10",
  "moonbitstack/moonproto@0.1.1",
}
