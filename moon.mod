name = "moonbitstack/moontel"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moontel"

license = "Apache-2.0"

keywords = [
  "opentelemetry",
  "otel",
  "tracing",
  "distributed-tracing",
  "trace-context",
  "w3c-trace-context",
  "traceparent",
  "tracestate",
  "baggage",
  "span",
  "sampler",
  "propagation",
  "observability",
  "telemetry",
  "asgi",
  "moonbit",
]

description = "OpenTelemetry for MoonBit."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonasgi@0.10.4",
  "moonbitstack/moonbase@0.4.2",
  "moonbitstack/moonrand@0.1.0",
}
